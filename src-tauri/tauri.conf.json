{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nilova",
  "version": "0.1.0",
  "identifier": "com.nilova.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nilova",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
 "bundle": {
  "active": false,
  "targets": "all",
  "icon": [
    "icons/icon.ico"
  ]
}
}
